# Copie para mcp/.env e preencha. Esse arquivo fica fora do git.
# URL e anon key: se ficarem vazias, o servidor lê VITE_SUPABASE_URL e
# VITE_SUPABASE_ANON_KEY do .env.local da raiz do projeto.
CONTENT_OS_SUPABASE_URL=
CONTENT_OS_SUPABASE_ANON_KEY=

# A mesma conta que você usa para entrar no Content OS.
CONTENT_OS_EMAIL=
CONTENT_OS_PASSWORD=
